# Copy to .env. Shell environment wins over this file.
# Generate a token with: openssl rand -hex 32

HOST=127.0.0.1
PORT=3000

# Required for every admin endpoint. Empty means the tunnel URL is the only
# thing protecting the console.
ADMIN_TOKEN=

# The existing opentunnel route. Leave empty to discover it at startup.
PUBLIC_URL=https://dc74e10b652050c0.pagbc52drfuq.opentunnel.xyz

# Release that holds the installer, the tunnel pointer, and the agent runtime.
GITHUB_REPO=Igidn/tethys
LIVE_TAG=live

DATA_DIR=data

HEARTBEAT_MS=5000
STALE_MS=20000
COMMAND_RETRY_MS=8000
EVENT_RETENTION_DAYS=14

# Set to 0 to skip the opentunnel check (tests, CI).
CHECK_TUNNEL=1
